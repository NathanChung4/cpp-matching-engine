#!/usr/bin/env bash
# Runs every check for this project and prints PASS/FAIL for each.
# Exits 0 only if all checks pass. Never prompts. Needs a C++20 compiler, CMake, Ninja
# and Python 3.
#   1. secret scan (stdlib-only scanner in scripts/)
#   2. Release build, warnings as errors
#   3. every test binary through CTest (Release), then every tests/test_*.sh
#   4. AddressSanitizer + UndefinedBehaviorSanitizer build of the tests, run through CTest
#      (ME_SANITIZE makes the long tests use smaller seeded runs)
set -u
cd "$(dirname "$0")"

export CI="${CI:-true}"
failed=0
results=()

run() {
  local name="$1"; shift
  echo "==> $name"
  if "$@"; then
    results+=("PASS  $name")
  else
    results+=("FAIL  $name")
    failed=1
  fi
}

jobs="$(sysctl -n hw.ncpu 2>/dev/null || echo 4)"

run "secret scan" python3 -I scripts/secret_scan.py --root .
run "release build (-Werror)" bash -c 'cmake -S . -B build/release -G Ninja -DCMAKE_BUILD_TYPE=Release > /dev/null && cmake --build build/release'
run "release tests (ctest)" ctest --test-dir build/release --output-on-failure -j "$jobs"
for t in tests/test_*.sh; do
  [ -e "$t" ] || continue
  run "shell test $(basename "$t")" bash "$t"
done
run "sanitizer build (asan+ubsan)" bash -c 'cmake -S . -B build/asan -G Ninja -DCMAKE_BUILD_TYPE=Debug -DME_SANITIZE=ON > /dev/null && cmake --build build/asan'
run "sanitizer tests (ctest)" ctest --test-dir build/asan --output-on-failure -j "$jobs"

echo
echo "==== validate summary ===="
printf '%s\n' "${results[@]}"
if [ "$failed" -ne 0 ]; then
  echo "validate: FAILED"
  exit 1
fi
echo "validate: all checks passed"
